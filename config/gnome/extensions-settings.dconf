[blur-my-shell]
rounded-blur-found=false
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
sigma=30
static-blur=true
style-dash-to-dock=0

[blur-my-shell/panel]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[burn-my-windows]
last-extension-version=48

[caffeine]
cli-toggle=false
indicator-position-max=1
user-enabled=true

[clipboard-history]
cache-size=1000
topbar-preview-size=1

[coverflowalttab]
icon-add-remove-effects='Fade and Scale'
icon-style='Overlay'
randomize-animation-times=true
switcher-background-color=(0.74117647058823533, 0.57647058823529407, 0.97647058823529409)
switcher-looping-method='Carousel'
switcher-style='Coverflow'

[dash-to-dock]
animation-time=0.20000000000000001
autohide=true
dock-fixed=false
dock-position='BOTTOM'
hide-delay=0.20000000000000001
intellihide=false
require-pressure-to-show=false
show-delay=0.10000000000000001

[just-perfection]
support-notifier-showed-version=36
support-notifier-type=0

[user-theme]
name='Dracula'
