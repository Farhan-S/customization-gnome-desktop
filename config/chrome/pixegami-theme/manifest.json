{
  "manifest_version": 3,
  "name": "Pixegami Theme",
  "version": "2.1",
  "description": "Navy/mint theme on the Pixegami palette (#0C1C25 / #86FFAF), with a hatched texture and layered depth so Chrome's capsule tabs and pill omnibox read clearly.",
  "theme": {
    "images": {
      "theme_frame": "images/frame.png",
      "theme_frame_inactive": "images/frame_inactive.png",
      "theme_frame_incognito": "images/frame.png",
      "theme_frame_incognito_inactive": "images/frame_inactive.png",
      "theme_toolbar": "images/toolbar.png",
      "theme_tab_background": "images/tab_background.png",
      "theme_ntp_background": "images/ntp_background.png"
    },

    "colors": {
      "frame": [5, 14, 20],
      "frame_inactive": [8, 18, 25],
      "frame_incognito": [3, 10, 15],
      "frame_incognito_inactive": [6, 14, 20],

      "toolbar": [22, 46, 59],
      "button_background": [34, 62, 79],

      "tab_text": [134, 255, 175],
      "tab_background_text": [120, 140, 152],
      "tab_background_text_inactive": [104, 122, 133],
      "tab_background_text_incognito": [138, 158, 170],
      "tab_background_text_incognito_inactive": [104, 122, 133],

      "toolbar_text": [232, 244, 240],
      "toolbar_button_icon": [134, 255, 175],
      "bookmark_text": [190, 208, 214],
      "focus_ring": [134, 255, 175],

      "omnibox_background": [34, 62, 79],
      "omnibox_text": [232, 244, 240],

      "ntp_background": [12, 28, 37],
      "ntp_text": [232, 244, 240],
      "ntp_link": [134, 255, 175],
      "ntp_header": [21, 37, 53]
    },

    "tints": {
      "buttons": [-1.0, -1.0, -1.0],
      "frame": [-1.0, -1.0, -1.0],
      "frame_inactive": [-1.0, -1.0, -1.0],
      "frame_incognito": [-1.0, -1.0, -1.0],
      "background_tab": [-1.0, -1.0, -1.0]
    },

    "properties": {
      "ntp_background_alignment": "top",
      "ntp_background_repeat": "repeat",
      "ntp_logo_alternate": 1
    }
  }
}
